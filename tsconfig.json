{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "/opt/nodejs/*": ["layers/*"]
    }
  },
  "include": ["src/**/*.ts", "layers/**/*.ts", "build.js"],
  "exclude": ["node_modules"]
}
