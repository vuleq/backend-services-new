{
  "name": "wdr-content-xml-to-pdf",
  "version": "1.0.0",
  "description": "AWS Lambda function to convert XML content from database to PDF format with enhanced formatting and error handling.",
  "main": "src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=dist/index.js --external:wdr-connect-db --external:wdr-models --external:wdr-error-codes --external:wdr-pdf-utils",
    "build:dev": "esbuild src/index.ts --bundle --sourcemap --platform=node --target=es2020 --outfile=dist/index.js --external:wdr-connect-db --external:wdr-models --external:wdr-error-codes --external:wdr-pdf-utils",
    "local": "npm run build && node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@types/aws-lambda": "^8.10.150",
    "aws-sdk": "^2.1000.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "esbuild": "^0.25.6",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "rimraf": "^4.4.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "AWS",
    "Lambda",
    "XML",
    "PDF",
    "conversion",
    "report-generation"
  ],
  "author": "KSL Solutions",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
